OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.5

# Optional. Use this if your network cannot reach api.openai.com directly.
# Example: HTTPS_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=

# Optional. Use this only for an OpenAI-compatible gateway/provider.
# Example: OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=

# Agent conversation database, file workspace, and approximate context budget.
AGENT_DATA_DIR=data
AGENT_WORKSPACE=workspace
AGENT_CONTEXT_CHARS=24000
# RAG 从当前会话的窗口外历史中召回的最大字符数和消息数。
AGENT_RAG_CHARS=5000
AGENT_RAG_LIMIT=5
AGENT_MAX_IMAGE_BYTES=4194304
WEB_PORT=3001

# Optional MCP server configuration file.
MCP_CONFIG=mcp.json
